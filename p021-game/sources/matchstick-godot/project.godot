; GAME-G015 Matchstick Godot redesign (GAME-062)
config_version=5

[application]
config/name="Matchstick"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.045,0.070,1)

[audio]
driver/enable_input=false
