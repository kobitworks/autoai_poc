; GAME-G014 / Switch Shortest Godot redesign (GAME-061)
config_version=5

[application]
config/name="Switch Shortest"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.018,0.035,0.075,1)

[audio]
driver/enable_input=false
