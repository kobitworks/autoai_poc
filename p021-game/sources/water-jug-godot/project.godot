; GAME-G013 / Water Jug Godot redesign (GAME-060)
config_version=5

[application]
config/name="Water Jug Lab"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.023,0.075,0.137,1)

[audio]
driver/enable_input=false
